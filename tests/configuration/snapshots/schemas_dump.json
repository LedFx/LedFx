{
 "audio": {
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": true,
   "description": "Persisted audio section: input and analysis settings together.",
   "properties": {
    "pitch_method": {
     "default": "yinfft",
     "description": "Method to detect pitch",
     "enum": [
      "yinfft",
      "yin",
      "yinfast",
      "schmitt",
      "specacf"
     ],
     "title": "Pitch Method",
     "type": "string"
    },
    "onset_method": {
     "default": "hfc",
     "description": "Method used to detect onsets",
     "enum": [
      "energy",
      "hfc",
      "complex",
      "phase",
      "wphase",
      "specdiff",
      "kl",
      "mkl",
      "specflux"
     ],
     "title": "Onset Method",
     "type": "string"
    },
    "pitch_tolerance": {
     "default": 0.8,
     "description": "Pitch detection tolerance",
     "maximum": 2,
     "minimum": 0.0,
     "title": "Pitch Tolerance",
     "type": "number"
    },
    "sample_rate": {
     "default": 60,
     "readOnly": true,
     "title": "Sample Rate",
     "type": "integer"
    },
    "mic_rate": {
     "default": 44100,
     "readOnly": true,
     "title": "Mic Rate",
     "type": "integer"
    },
    "fft_size": {
     "default": 4096,
     "readOnly": true,
     "title": "Fft Size",
     "type": "integer"
    },
    "min_volume": {
     "default": 0.2,
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Min Volume",
     "type": "number"
    },
    "audio_device": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Audio Device",
     "x-ledfx-enum-source": "audio_devices"
    },
    "audio_device_name": {
     "default": "",
     "readOnly": true,
     "title": "Audio Device Name",
     "type": "string"
    },
    "delay_ms": {
     "default": 0,
     "description": "Add a delay to LedFx's output to sync with your audio. Useful for Bluetooth devices which typically have a short audio lag.",
     "maximum": 5000,
     "minimum": 0,
     "title": "Delay Ms",
     "type": "integer"
    }
   },
   "title": "AudioConfig",
   "type": "object"
  }
 },
 "melbanks": {
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": true,
   "properties": {
    "samples": {
     "default": 24,
     "maximum": 100,
     "minimum": 0,
     "title": "Samples",
     "type": "integer"
    },
    "peak_isolation": {
     "default": 0.4,
     "maximum": 0.99,
     "minimum": 0.0,
     "title": "Peak Isolation",
     "type": "number"
    },
    "coeffs_type": {
     "default": "matt_mel",
     "enum": [
      "matt_mel",
      "triangle",
      "bark",
      "mel",
      "htk",
      "scott",
      "scott_mel"
     ],
     "title": "Coeffs Type",
     "type": "string"
    },
    "max_frequencies": {
     "default": [
      350,
      2000,
      15000
     ],
     "items": {
      "maximum": 15000,
      "minimum": 0,
      "type": "integer"
     },
     "title": "Max Frequencies",
     "type": "array"
    },
    "min_frequency": {
     "default": 20,
     "maximum": 15000,
     "minimum": 0,
     "title": "Min Frequency",
     "type": "integer"
    }
   },
   "title": "MelbanksConfig",
   "type": "object"
  }
 },
 "melbank_collection": {
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": true,
   "properties": {
    "name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Name"
    },
    "min_frequency": {
     "default": 20,
     "maximum": 15000,
     "minimum": 20,
     "title": "Min Frequency",
     "type": "integer"
    },
    "max_frequency": {
     "default": 15000,
     "maximum": 15000,
     "minimum": 20,
     "title": "Max Frequency",
     "type": "integer"
    }
   },
   "title": "MelbankConfig",
   "type": "object"
  }
 },
 "wled_preferences": {
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$defs": {
    "WledBoolSetting": {
     "additionalProperties": false,
     "properties": {
      "setting": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Setting"
      },
      "user_enabled": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "User Enabled"
      }
     },
     "title": "WledBoolSetting",
     "type": "object"
    },
    "WledIntSetting": {
     "additionalProperties": false,
     "properties": {
      "setting": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Setting"
      },
      "user_enabled": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "User Enabled"
      }
     },
     "title": "WledIntSetting",
     "type": "object"
    },
    "WledStrSetting": {
     "additionalProperties": false,
     "properties": {
      "setting": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Setting"
      },
      "user_enabled": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "User Enabled"
      }
     },
     "title": "WledStrSetting",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "wled_preferred_mode": {
     "$ref": "#/$defs/WledStrSetting",
     "default": {
      "setting": "UDP",
      "user_enabled": false
     },
     "title": "Wled Preferred Mode"
    },
    "realtime_gamma_enabled": {
     "$ref": "#/$defs/WledBoolSetting",
     "default": {
      "setting": false,
      "user_enabled": false
     },
     "title": "Realtime Gamma Enabled"
    },
    "force_max_brightness": {
     "$ref": "#/$defs/WledBoolSetting",
     "default": {
      "setting": false,
      "user_enabled": false
     },
     "title": "Force Max Brightness"
    },
    "realtime_dmx_mode": {
     "$ref": "#/$defs/WledStrSetting",
     "default": {
      "setting": "MultiRGB",
      "user_enabled": false
     },
     "title": "Realtime Dmx Mode"
    },
    "start_universe_setting": {
     "$ref": "#/$defs/WledIntSetting",
     "default": {
      "setting": 1,
      "user_enabled": false
     },
     "title": "Start Universe Setting"
    },
    "dmx_address_start": {
     "$ref": "#/$defs/WledIntSetting",
     "default": {
      "setting": 1,
      "user_enabled": false
     },
     "title": "Dmx Address Start"
    },
    "inactivity_timeout": {
     "$ref": "#/$defs/WledIntSetting",
     "default": {
      "setting": 1,
      "user_enabled": false
     },
     "title": "Inactivity Timeout"
    }
   },
   "title": "WledPreferences",
   "type": "object"
  }
 },
 "virtuals": {
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "name": {
     "description": "Friendly name for the device",
     "title": "Name",
     "type": "string"
    },
    "mapping": {
     "default": "span",
     "description": "Span: Effect spans all segments. Copy: Effect copied on each segment",
     "enum": [
      "span",
      "copy"
     ],
     "title": "Mapping",
     "type": "string"
    },
    "complex_segments": {
     "default": false,
     "description": "Use complex segment mapping mode for performance",
     "title": "Complex Segments",
     "type": "boolean"
    },
    "grouping": {
     "default": 1,
     "description": "Number of physical pixels to combine into larger virtual pixel groups",
     "minimum": 0,
     "title": "Grouping",
     "type": "integer"
    },
    "icon_name": {
     "default": "mdi:led-strip-variant",
     "description": "Icon for the device*",
     "title": "Icon Name",
     "type": "string"
    },
    "max_brightness": {
     "default": 1.0,
     "description": "Max brightness for the device",
     "maximum": 1,
     "minimum": 0,
     "title": "Max Brightness",
     "type": "number"
    },
    "center_offset": {
     "default": 0,
     "description": "Number of pixels from the perceived center of the device",
     "title": "Center Offset",
     "type": "integer"
    },
    "preview_only": {
     "default": false,
     "description": "Preview the pixels without updating the devices",
     "title": "Preview Only",
     "type": "boolean"
    },
    "transition_time": {
     "default": 0.4,
     "description": "Length of transition between effects",
     "maximum": 5,
     "minimum": 0,
     "title": "Transition Time",
     "type": "number"
    },
    "transition_mode": {
     "default": "Add",
     "description": "Type of transition between effects",
     "enum": [
      "Add",
      "Dissolve",
      "Push",
      "Slide",
      "Iris",
      "Through White",
      "Through Black",
      "None"
     ],
     "title": "Transition Mode",
     "type": "string"
    },
    "frequency_min": {
     "default": 20,
     "description": "Lowest frequency for this virtual's audio reactive effects",
     "maximum": 15000,
     "minimum": 20,
     "title": "Frequency Min",
     "type": "integer"
    },
    "frequency_max": {
     "default": 15000,
     "description": "Highest frequency for this virtual's audio reactive effects",
     "maximum": 15000,
     "minimum": 20,
     "title": "Frequency Max",
     "type": "integer"
    },
    "rows": {
     "default": 1,
     "description": "Amount of rows. > 1 if this virtual is a matrix",
     "minimum": 1,
     "title": "Rows",
     "type": "integer"
    },
    "rotate": {
     "default": 0,
     "description": "90 Degree rotations",
     "maximum": 3,
     "minimum": 0,
     "title": "Rotate",
     "type": "integer"
    }
   },
   "required": [
    "name"
   ],
   "title": "VirtualConfig",
   "type": "object"
  }
 },
