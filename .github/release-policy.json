{
  "schema_version": 1,
  "repository": "LedFx/LedFx",
  "workflow": ".github/workflows/ci.yml",
  "tag_prefix": "v",
  "python": {
    "project": "LedFx",
    "wheel_stem": "ledfx",
    "wheel_tags": [
      "py3-none-any"
    ],
    "sdist": "ledfx-{version}.tar.gz"
  },
  "github_assets": {
    "distributions": false,
    "files": [
      "LedFx-{tag_version}-win-x64.zip",
      "LedFx-{tag_version}-win-x64-setup.zip",
      "LedFx-{tag_version}-osx-arm64.tar.gz",
      "LedFx-{tag_version}-osx-intel.tar.gz"
    ]
  },
  "oci": [
    {
      "image": "ghcr.io/ledfx/ledfx",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "version_tag": "{tag_version}",
      "promote_latest": true
    },
    {
      "image": "docker.io/ledfxorg/ledfx",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "version_tag": "{tag_version}",
      "promote_latest": true
    }
  ]
}
